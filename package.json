{
  "name": "@vencore/calendar-plugin",
  "version": "1.0.0",
  "description": "Workspace calendar with events and milestones",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "powershell -Command \"Compress-Archive -Path src, plugin.json, package.json -DestinationPath calendar-plugin.zip -Force\"",
    "clean": "powershell -Command \"if (Test-Path calendar-plugin.zip) { Remove-Item calendar-plugin.zip }\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@vencore/plugin-sdk": "file:../vencore-plugin-sdk/packages/plugin-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vencore/plugin-types": "file:../vencore-plugin-sdk/packages/plugin-types",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
